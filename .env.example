DJANGO_SECRET_KEY=cambiar-esto-en-produccion
DJANGO_DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
DETECTOR_MODEL=yolov8n.pt
DETECTOR_IMGSZ=640
DETECTOR_DEVICE=cpu
SAMPLE_FPS=2
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
CLIP_RETENTION_DAYS=30

# --- Producción (ver README, sección "Desplegar en la VM") ---
# Generar la clave con:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# True SOLO cuando de verdad haya certificado en /etc/ssl/vision/.
# Ponerlo en True sin certificado deja el panel inalcanzable y graba HSTS un año.
DJANGO_TLS=False
APP_VERSION=dev
